{
  "name": "@worthit/taro-app",
  "version": "0.1.0",
  "private": true,
  "description": "值啦 Taro 主工程：一套代码编译微信小程序 + H5",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@worthit/core": "workspace:*",
    "@worthit/storage": "workspace:*",
    "dayjs": "^1.11.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-preset-taro": "4.2.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^4.5.14"
  }
}
