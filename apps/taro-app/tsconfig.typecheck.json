{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@worthit/core": ["../../packages/core/src/index.ts"],
      "@worthit/storage": ["../../packages/storage/src/index.ts"]
    },
    "types": ["@tarojs/taro"]
  },
  "include": ["./src", "./types", "./config"],
  "exclude": ["node_modules", "dist"]
}
