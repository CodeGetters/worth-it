{
  "name": "@worthit/core",
  "version": "0.1.0",
  "private": true,
  "description": "值啦核心计算逻辑：纯 TS、零框架，仅依赖 dayjs（日期运算），四端共享",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  }
}
